{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "观海·八分",
  "version": "0.3.0",
  "identifier": "com.guanhai.bafen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "观海·八分｜文件封装与恢复",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Guanhai Bafen: local file encryption and EN3 recovery",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
