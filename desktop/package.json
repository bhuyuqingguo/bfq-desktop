{
  "name": "bfq-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:windows": "tauri build --no-bundle --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build --bundles deb --target x86_64-unknown-linux-gnu",
    "build:macos": "tauri build --bundles app",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
